 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Parking Demand - Exploratory Data Analysis\n",
    "\n",
    "This notebook explores the parking occupancy dataset to understand patterns\n",
    "before building predictive models.\n",
    "\n",
    "**Author:** Praansu Karmacharya\n",
    "**Date:** 2024\n",
    "\n",
    "---\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Standard imports\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# Plot styling\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "sns.set_palette(\"husl\")\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "plt.rcParams['font.size'] = 11\n",
    "\n",
    "# Display settings\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', 1000)\n",
    "\n",
    "print(\"Imports done.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "DATA_PATH = \"../data/parking.csv\"\n",
    "\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"])\n",
    "df = df.sort_values(\"timestamp\").reset_index(drop=True)\n",
    "\n",
    "print(f\"Shape: {df.shape}\")\n",
    "print(f\"Date range: {df['timestamp'].min()} to {df['timestamp'].max()}\")\n",
    "print(f\"\\nColumns: {list(df.columns)}\")\n",
    "print(f\"\\nDtypes:\\n{df.dtypes}\")\n",
    "print(f\"\\nBasic stats:\\n{df.describe()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check for missing values\n",
    "print(\"Missing values per column:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Check for duplicates\n",
    "print(f\"\\nDuplicate rows: {df.duplicated().sum()}\")\n",
    "\n",
    "# Check timestamp continuity\n",
    "df_sorted = df.sort_values(\"timestamp\").reset_index(drop=True)\n",
    "time_diffs = df_sorted[\"timestamp\"].diff().dt.total_seconds() / 3600\n",
    "print(f\"\\nTime gaps (hours):\")\n",
    "print(time_diffs.value_counts().head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Occupancy distribution\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Histogram\n",
    "axes[0, 0].hist(df[\"occupancy\"], bins=50, edgecolor=\"black\", alpha=0.7)\n",
    "axes[0, 0].set_xlabel(\"Occupancy\")\n",
    "axes[0, 0].set_ylabel(\"Frequency\")\n",
    "axes[0, 0].set_title(\"Occupancy Distribution\")\n",
    "axes[0, 0].axvline(df[\"occupancy\"].mean(), color=\"red\", linestyle=\"--\", label=f\"Mean: {df['occupancy'].mean():.1f}\")\n",
    "axes[0, 0].legend()\n",
    "\n",
    "# Box plot by hour\n",
    sns.boxplot(data=df, x=\"hour\", y=\"occupancy\", ax=axes[0, 1])\n",
    "axes[0, 1].set_title(\"Occupancy by Hour of Day\")\n",
    "axes[0, 1].set_xlabel(\"Hour of Day\")\n",
    "axes[0, 1].set_ylabel(\"Occupancy\")\n",
    "\n",
    "# Box plot by day of week\n",
    dow_labels = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n",
    sns.boxplot(data=df, x=\"day_of_week\", y=\"occupancy\", ax=axes[1, 0])\n",
    "axes[1, 0].set_xticklabels(dow_labels)\n",
    "axes[1, 0].set_title(\"Occupancy by Day of Week\")\n",
    "axes[1, 0].set_xlabel(\"Day of Week\")\n",
    "axes[1, 0].set_ylabel(\"Occupancy\")\n",
    "\n",
    "# Weekend vs Weekday\n",
    sns.boxplot(data=df, x=\"is_weekend\", y=\"occupancy\", ax=axes[1, 1])\n",
    "axes[1, 1].set_xticklabels([\"Weekday\", \"Weekend\"])\n",
    "axes[1, 1].set_title(\"Weekend vs Weekday\")\n",
    "axes[1, 1].set_xlabel(\"\"); axes[1, 1].set_ylabel(\"Occupancy\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time series plot - full year\n",
    "plt.figure(figsize=(16, 6))\n",
    "plt.plot(df[\"timestamp\"], df[\"occupancy\"], linewidth=0.5, alpha=0.7)\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Occupancy\")\n",
    "plt.title(\"Parking Occupancy - Full Year\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Zoom in - first month\n",
    "jan = df[df[\"timestamp\"].dt.month == 1]\n",
    "\n",
    "plt.figure(figsize=(16, 6))\n",
    "plt.plot(jan[\"timestamp\"], jan[\"occupancy\"], linewidth=0.8, alpha=0.8)\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Occupancy\")\n",
    "plt.title(\"Parking Occupancy - January (Zoom)\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Heatmap: Hour vs Day of Week\n",
    "pivot = df.pivot_table(values=\"occupancy\", index=\"hour\", columns=\"day_of_week\", aggfunc=\"mean\")\n",
    "pivot.columns = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(pivot, annot=True, fmt=\".0f\", cmap=\"YlOrRd\", cbar_kws={\"label\": \"Avg Occupancy\"})\n",
    "plt.title(\"Average Occupancy by Hour and Day of Week\")\n",
    "plt.xlabel(\"Day of Week\")\n",
    "plt.ylabel(\"Hour of Day\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Weekend vs Weekday hourly patterns\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5), sharey=True)\n",
    "\n",
    "weekday = df[df[\"is_weekend\"] == 0].groupby(\"hour\")[\"occupancy\"].mean()\n",
    "weekend = df[df[\"is_weekend\"] == 1].groupby(\"hour\")[\"occupancy\"].mean()\n",
    "\n",
    "axes[0].plot(weekday.index, weekday.values, marker=\"o\", label=\"Weekday\", linewidth=2)\n",
    "axes[0].plot(weekend.index, weekend.values, marker=\"s\", label=\"Weekend\", linewidth=2)\n",
    "axes[0].set_xlabel(\"Hour of Day\")\n",
    "axes[0].set_ylabel(\"Average Occupancy\")\n",
    "axes[0].set_title(\"Average Hourly Occupancy: Weekday vs Weekend\")\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "axes[0].set_xticks(range(0, 24, 2))\n",
    "\n",
    "# Difference\n",
    diff = weekday - weekend\n",
    axes[1].bar(diff.index, diff.values, color=[\"red\" if x < 0 else \"blue\" for x in diff.values])\n",
    "axes[1].axhline(y=0, color=\"black\", linewidth=0.5)\n",
    "axes[1].set_xlabel(\"Hour of Day\")\n",
    "axes[1].set_ylabel(\"Weekday - Weekend\")\n",
    "axes[1].set_title(\"Difference (Weekday - Weekend)\")\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "axes[1].set_xticks(range(0, 24, 2))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Holiday vs Non-holiday\n",
    "if \"is_holiday\" in df.columns:\n",
    "    hol = df[df[\"is_holiday\"] == 1][\"occupancy\"]\n",
    "    non_hol = df[df[\"is_holiday\"] == 0][\"occupancy\"]\n",
    "    \n",
    "    print(f\"Holiday mean: {hol.mean():.1f}, Non-holiday mean: {non_hol.mean():.1f}\")\n",
    "    \n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.hist([non_hol, hol], bins=40, label=[\"Non-holiday\", \"Holiday\"], alpha=0.7, edgecolor=\"black\")\n",
    "    plt.xlabel(\"Occupancy\")\n",
    "    plt.ylabel(\"Frequency\")\n",
    "    plt.title(\"Occupancy Distribution: Holiday vs Non-holiday\")\n",
    "    plt.legend()\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"No holiday column in data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Event impact\n",
    "if \"is_event\" in df.columns:\n",
    "    event = df[df[\"is_event\"] == 1][\"occupancy\"]\n",
    "    non_event = df[df[\"is_event\"] == 0][\"occupancy\"]\n",
    "    \n",
    "    print(f\"Event mean: {event.mean():.1f}, Non-event mean: {non_event.mean():.1f}\")\n",
    "    print(f\"Event count: {len(event)}, Non-event count: {len(non_event)}\")\n",
    "    \n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.hist([non_event, event], bins=40, label=[\"Normal\", \"Event\"], alpha=0.7, edgecolor=\"black\")\n",
    "    plt.xlabel(\"Occupancy\")\n",
    "    plt.ylabel(\"Frequency\")\n",
    "    plt.title(\"Occupancy Distribution: Event vs Normal\")\n",
    "    plt.legend()\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"No event column in data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation matrix\n",
    "numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "corr = df[numeric_cols].corr()\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "mask = np.triu(np.ones_like(corr, dtype=bool))\n",
    "sns.heatmap(corr, mask=mask, annot=True, fmt=\".2f\", cmap=\"RdBu_r\", center=0,\n",
    "            square=True, linewidths=0.5, cbar_kws={\"shrink\": 0.8})\n",
    "plt.title(\"Feature Correlation Matrix\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Autocorrelation\n",
    "from pandas.plotting import autocorrelation_plot\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "autocorrelation_plot(df[\"occupancy\"].values)\n",
    "plt.title(\"Autocorrelation of Occupancy\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Seasonal decomposition\n",
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "\n",
    "# Resample to daily frequency for cleaner decomposition\n",
    "daily = df.set_index(\"timestamp\")[\"occupancy\"].resample(\"D\").mean()\n",
    "\n",
    "result = seasonal_decompose(daily, model=\"additive\", period=7)\n",
    "\n",
    "fig, axes = plt.subplots(4, 1, figsize=(14, 12), sharex=True)\n",
    "result.observed.plot(ax=axes[0], title=\"Observed\")\n",
    "result.trend.plot(ax=axes[1], title=\"Trend\", color=\"red\")\n",
    "result.seasonal.plot(ax=axes[2], title=\"Seasonal (Weekly)\", color=\"green\")\n",
    "result.resid.plot(ax=axes[3], title=\"Residual\", color=\"orange\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## Key Observations\n",
    "\n",
    "1. **Strong daily cycle** - Clear peaks at 10am and 6pm on weekdays\n",
    "2. **Weekend pattern differs** - Later morning peak, lower overall\n",
    "3. **Holidays drop occupancy** ~50% - makes sense, fewer commuters\n",
    "3. **Events cause spikes** - 2-3x normal occupancy during events\n",
    "4. **Strong weekly seasonality** - Clear 7-day pattern in decomposition\n",
    "4. **High autocorrelation** - Hourly data highly correlated with recent hours\n",
    "\n",
    "---\n",
    "\n",
    "## Next Steps\n",
    "\n",
    "- Feature engineering: lag features, rolling windows, cyclical encoding\n",
    "- Model training: Linear Regression → Random Forest → XGBoost\n",
    "- Evaluation: time-series split, MAE/RMSE/R², residual analysis\n",
    "\n",
    "---\n",
    "\n",
    "*Notebook by Praansu Karmacharya*"
   ]
  },
